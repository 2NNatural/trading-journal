{
  "name": "robinhood-journal-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "phase1": "node --disable-warning=ExperimentalWarning scripts/phase1/run.ts",
    "test": "node --test scripts/phase1/*.test.ts",
    "typecheck": "tsc --noEmit",
    "web:check": "node --check web/app.js && node --check api/health.js",
    "web:dev": "python3 -m http.server 3000 --directory web"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "lossless-json": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
