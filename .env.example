# Vercel server-side configuration.
# SUPABASE_PUBLISHABLE_KEY is safe to expose to the browser when RLS is configured.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Functions receive their project URL / project keys from Supabase.
# Do not commit service-role keys or wallet private keys to this repo.

# This app only needs PUBLIC wallet addresses, configured in the database after install.
