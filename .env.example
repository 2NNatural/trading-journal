# Phase 1 inputs. Fill these two values to enable real GMGN wallet tests.
# Public Robinhood mainnet wallet address (0x followed by 40 hex characters).
TEST_WALLET=
# API key for read-only GMGN queries. Never put a wallet private key here.
GMGN_API_KEY=

# Optional: Alchemy API key for Robinhood mainnet verification.
ALCHEMY_API_KEY=
# Optional: explicit Robinhood mainnet RPC URL. It may itself contain a secret.
# Leave blank to use the public RPC initially (or Alchemy when configured).
ROBINHOOD_RPC_URL=

# Optional separate FREE trace endpoint. Keeps Alchemy Free for indexed transfers.
# Example provider URL format: https://rpc.solidrpc.io/YOUR_API_KEY/evm/4663
# Provider's Free plan is documented; tracing still needs live validation.
ROBINHOOD_TRACE_RPC_URL=
